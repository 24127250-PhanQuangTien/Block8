# HTTP port for Express.
PORT=3000
# Set to production to enable Secure cookies.
NODE_ENV=development
# Prisma/Supabase pooler connection string.
DATABASE_URL=postgresql://user:password@pooler-host:6543/database?pgbouncer=true
# Direct Supabase connection; use for sessions if the pooler is incompatible.
DIRECT_URL=postgresql://user:password@direct-host:5432/database
# Optional connection string used only by connect-pg-simple.
# SESSION_DATABASE_URL=postgresql://user:password@direct-host:5432/database
# Use unique random values of at least 32 bytes; never commit real secrets.
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-a-different-at-least-32-random-secret
# Public URL used in password-reset links and the browser origin used for CSRF.
APP_BASE_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Trusted proxy hop count: 0 when connecting directly, 1 behind one proxy.
TRUST_PROXY=0
# Optional SMTP credentials. Empty SMTP_HOST uses an Ethereal test account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Restaurant App <no-reply@example.test>
# Active account created by `npm run seed:auth`.
SEED_USER_EMAIL=admin@example.test
SEED_USER_PASSWORD=replace-with-a-strong-password
